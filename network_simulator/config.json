{
  "_metadata": {
    "version": "1.0",
    "description": "Network topology generation configuration",
    "last_updated": "2025-10-14"
  },

  "connection_algorithm": {
    "_description": "Three-phase connection building algorithm",
    "gamma": {
      "value": 0.0,
      "description": "Capacity importance in S(u,v) = (Cu×Cv)^gamma / d^beta",
      "range": [0.0, 2.0]
    },
    "beta": {
      "value": 1.5,
      "description": "Distance penalty exponent. Higher = favor nearby nodes",
      "range": [1.0, 3.0]
    },
    "eta": {
      "value": 0.10,
      "description": "Phase I weight fraction: w = eta × min(residual)",
      "range": [0.08, 0.5]
    },
    "target_edges": {
      "value": 200,
      "description": "Target connection count (48 nodes → avg degree ~8.3)"
    },
    "noise_factor": {
      "value": 0.01,
      "description": "Random noise for tie-breaking (±1%)",
      "range": [0.001, 0.05]
    },
    "random_seed": {
      "value": 42,
      "description": "Random seed (null = non-deterministic)"
    }
  },

  "alpha_functions": {
    "_description": "Alpha functions scale edge weights in Phase II/III",
    "phase_ii": {
      "_description": "Phase II: α(S) = base + coefficient × normalized_score",
      "alpha_base": {
        "value": 0.12,
        "description": "Min alpha value",
        "range": [0.10, 0.5]
      },
      "alpha_coefficient": {
        "value": 0.01,
        "description": "Alpha range above base",
        "range": [0.005, 0.3]
      }
    },
    "phase_iii": {
      "_description": "Phase III: local spokes",
      "alpha_base": {
        "value": 0.12,
        "range": [0.10, 0.5]
      },
      "alpha_coefficient": {
        "value": 0.01,
        "range": [0.005, 0.3]
      }
    }
  },

  "graph_construction": {
    "min_distance_threshold": {
      "value": 0.001,
      "description": "Min distance to avoid division by zero"
    },
    "non_hub_threshold": {
      "value": 0.75,
      "description": "Bottom 75% of nodes by capacity get extra spokes"
    },
    "spokes_per_node": {
      "value": 2,
      "description": "Max extra connections per non-hub node",
      "range": [1, 3]
    },
    "capacity_tolerance": {
      "value": 1e-6,
      "description": "Float tolerance for capacity validation (Gbps)"
    }
  },

  "service_routing": {
    "_description": "Capacity-constrained service routing (two-stage)",
    "demand_gbps": {
      "value": 5.0,
      "description": "Fixed bandwidth per service",
      "range": [5.0, 50.0]
    },
    "target_services": {
      "value": 100,
      "description": "Target service count (Stage A + Stage B)",
      "range": [50, 200]
    },
    "p_exponent": {
      "value": 1.5,
      "description": "Cost function: cost = (r/D)^(-p). Higher = prefer high residual",
      "range": [1.0, 2.5]
    },
    "rho_exponent": {
      "value": 1.0,
      "description": "Endpoint sampling: P(v) ∝ (Σr)^rho. Higher = favor hubs",
      "range": [0.5, 2.0]
    },
    "noise_delta": {
      "value": 0.01,
      "description": "Dijkstra tie-breaking noise",
      "range": [0.001, 0.05]
    },
    "random_seed": {
      "value": 42,
      "description": "Random seed (null = non-deterministic)"
    },
    "enable_stage_a": {
      "value": true,
      "description": "Stage A: edge cover for endpoint coverage"
    }
  },

  "paths": {
    "data_dir": {
      "value": "data",
      "description": "Input CSV location"
    },
    "output_dir": {
      "value": "output",
      "description": "Visualization destination"
    }
  },

  "tuning_guide": {
    "_description": "Quick reference for distribution shapes",
    "bell_shaped": "gamma=0.5-0.8, beta=1.5, eta=0.5, alpha_base=0.40, alpha_coef=0.10",
    "power_law": "gamma=1.5, beta=2.0, eta=0.4, alpha_base=0.25, alpha_coef=0.25 (current)",
    "uniform": "gamma=0.0, beta=0.0, eta=0.45, alpha_base=0.45, alpha_coef=0.05"
  }
}
